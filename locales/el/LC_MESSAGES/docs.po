"%ce%bc%ce%b9%ce%b1-%ce%b5%cf%86%ce%b1%cf%81%ce%bc%ce%bf%ce%b3%ce%ae-%cf%84%ce%bf%cf%85"
"-de-"
"lhospital-%cf%83%cf%84%ce%b7%ce%bd-%cf%80%ce%b1%cf%81%ce%b1%ce%b3%cf%89%ce%b3%ce%b9%cf%83%ce%b9%ce%bc"
