#, python-format
msgid ""
"%ce%b1%ce%b4%cf%8d%ce%bd%ce%b1%cf%84%ce%bf-"
"vs-%ce%b1%cf%80%ce%af%ce%b8%ce%b1%ce%bd%ce%bf-%ce%bc%ce%ad%cf%81%ce%bf%cf%82-%ce%b2"
msgstr ""

