#: ../../docs/After-maths/ολο-clear-ώματα-ολοκλήρωση-vs-αντιπαραγώγισ.rst:139
msgid ""
"f(x)=\\left\\{\\begin{array}{ll}2x\\sin\\frac{1}{x^2}-\\frac{2}{x}\\cos\\frac{1}{x^2}"
" & x\\neq0\\0 & x=0\\end{array}\\right.,\n"
"\n"
msgstr ""

#: ../../docs/After-maths/ολο-clear-ώματα-ολοκλήρωση-vs-αντιπαραγώγισ.rst:141
#, python-brace-format
msgid ""
"η οποία έχει παράγουσα στο  :math:`\\mathbb{R}` , ωστόσο, δεν είναι "
