#: ../../docs/Διδακτικό-Υλικό/Α-Λυκείου/Άλγεβρα/Ρίζες/index.rst:2
#: ../../docs/Τεστάκι-της-ημέρας/Α-Λυκείου/Ρίζες/index.rst:2
msgid "Ρίζες"
msgstr ""

#: ../../docs/After-maths/σχεδιάζοντας-καμπύλες.rst:70
msgid ""
