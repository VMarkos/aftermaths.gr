#: ../../docs/After-maths/ολο-clear-ώματα-ολοκλήρωση-vs-αντιπαραγώγισ.rst:107
#, python-brace-format
msgid ""
"\\left(x^2\\sin\\dfrac{1}{x}\\right)'&=(x^2)'\\sin\\dfrac{1}{x}+x^2\\left(\\sin\\dfrac{1}{x}\\right)'\\\\"
" "
"&=2x\\sin\\dfrac{1}{x}+x^2\\cos\\dfrac{1}{x}\\left(\\dfrac{1}{x}\\right)'\\\\"
" "
"&=2x\\sin\\dfrac{1}{x}+x^2\\cos\\dfrac{1}{x}\\left(-\\dfrac{1}{x^2}\\right)\\\\"
" &=2x\\sin\\dfrac{1}{x}-\\cos\\dfrac{1}{x}.\n"
"\n"
msgstr ""

