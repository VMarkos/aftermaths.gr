#, python-brace-format
msgid ""
"\\begin{cases} 2\\alpha=4\\\\ \\alpha^2-4=0 \\end{cases}.\n"
"\n"
msgstr ""

#: ../../docs/Διδακτικό-Υλικό/Γ-ΓΕΛ/Μαθηματικά/Επανάληψη/τα-λυμένα-θέμα1.rst:72
msgid "Από την πρώτη εύκολα έχουμε:"
msgstr ""

#: ../../docs/Διδακτικό-Υλικό/Γ-ΓΕΛ/Μαθηματικά/Επανάληψη/τα-λυμένα-θέμα1.rst:74
msgid ""
"2\\alpha=4\\Leftrightarrow\\alpha=2.\n"
"\n"
msgstr ""

#: ../../docs/Διδακτικό-Υλικό/Γ-ΓΕΛ/Μαθηματικά/Επανάληψη/τα-λυμένα-θέμα1.rst:76
