#: ../../docs/Διδακτικό-Υλικό/Γ-ΓΕΛ/Μαθηματικά/Επανάληψη/τα-λυμένα-θέμα1.rst:102
msgid ""
"h_2(x)=x^2+8x+12.\n"
"\n"
msgstr ""

#: ../../docs/Διδακτικό-Υλικό/Γ-ΓΕΛ/Μαθηματικά/Επανάληψη/τα-λυμένα-θέμα1.rst:104
msgid ""
