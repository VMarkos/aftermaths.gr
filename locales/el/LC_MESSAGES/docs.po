#: ../../docs/After-maths/η-εικασία-collatz-3.rst:52
#, python-brace-format
msgid ""
"S:=\\{3n+2:n=0,1,\\ldots\\}=\\{2,5,8,\\ldots\\}.\n"
"\n"
msgstr ""

#: ../../docs/After-maths/η-εικασία-collatz-3.rst:54
msgid ""
