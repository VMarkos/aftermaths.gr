#: ../../docs/Διδακτικό-Υλικό/Γ-ΓΕΛ/Μαθηματικά/Συναρτήσεις/τα-λυμένα-θέμα2.rst:98
#: ../../docs/Διδακτικό-Υλικό/Γ-ΓΕΛ/Μαθηματικά/Συναρτήσεις/τα-λυμένα-θέμα2.rst:102
msgid ""
