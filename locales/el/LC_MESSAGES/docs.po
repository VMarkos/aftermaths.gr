"(x,y)=A+\\Delta\\vec{x}=(2,3)+(2t,2t)=(2+2t,3+2t).\n"
"\n"
msgstr ""

#: ../../docs/After-maths/οι-καμπύλες-που-άλλαξαν-τον-κόσμο.rst:104
msgid "Αν παίξουμε λίγο με το παραπάνω, παρατηρούμε ότι:"
