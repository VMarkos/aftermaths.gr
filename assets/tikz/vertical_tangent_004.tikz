\begin{tikzpicture}
	\draw[thick,->,name path=x axis] (-4,0) -- (4,0)node[pos=1,below]{$x$};
	\draw[thick,->,name path=y axis] (0,-3) -- (0,3)node[pos=1,left]{$y$};
	\node[right,yshift=-8pt] at (0,0){$O$};
	\draw[thick, domain={0}:{3.6}, samples=200, name path=curve] plot (\x,{(\x)^(1/3)})node[right]{$f$};
	\draw[thick, domain={-2.7}:{0}] plot (\x,{\x});
	\draw[dashed, domain={0}:{2.7}] plot (\x,{\x})node[right]{$y=x$};
	\node[circle, inner sep=1pt, fill=black](O) at (0,0){};
	\begin{pgfonlayer}{bg}
		\foreach \i in {47,49,...,90}{
			\draw[color=gray, shorten <=-2.7cm] (0,0) -- (\i:2.7);
		}
	\end{pgfonlayer}
\end{tikzpicture}