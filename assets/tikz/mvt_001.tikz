\begin{tikzpicture}
	\draw[thick,->,name path=x axis] (-1,0) -- (7,0)node[pos=1,below]{$x$};
	\draw[thick,->,name path=y axis] (0,-1) -- (0,7)node[pos=1,left]{$y$};
	\node[left,yshift=-8pt] at (0,0){$O$};
	\draw[thick, domain={1}:{6}, samples=200, name path=curve] plot (\x,{.3*(\x-1)*(\x-3)*(\x-5)+1.5})node[right]{$f$};
	\draw[dashed] (0,0) rectangle (1,1.5);
	\draw[dashed] (0,0) rectangle (6,6);
	\node[circle, inner sep=1pt, fill=black, label={below, xshift=-8pt}:{$A$}] at (1,1.5){};
	\node[circle, inner sep=1pt, fill=black, label={above}:{$B$}] at (6,6){};
	\node[below] at (1,0){$a$};
	\node[below] at (6,0){$b$};
	\node[left] at (0,1.5){$f(a)$};
	\node[left] at (0,6){$f(b)$};
	\draw[thin] (1,1.5) -- (6,6);
	\node[draw=none, inner sep=0pt, outer sep=0pt](left) at ({3-sqrt(14/6)},0){};
	\node[draw=none, inner sep=0pt, outer sep=0pt](right) at ({3+sqrt(14/6)},0){};
	\draw[draw=none, name path=line left] ($(-1,-1)!(left)!(7,-1)$) -- ($(-1,7)!(left)!(7,7)$);
	\draw[draw=none, name path=line right] ($(-1,-1)!(right)!(7,-1)$) -- ($(-1,7)!(right)!(7,7)$);
	\node[circle, inner sep=1pt, outer sep=0pt, fill=black, name intersections={of=curve and line left}](fleft) at (intersection-1){};
	\node[circle, inner sep=1pt, outer sep=0pt, fill=black, name intersections={of=curve and line right}](fright) at (intersection-1){};
	\draw[densely dotted] (left) -- (fleft)node[pos=0, below]{$x_0$};
	\draw[densely dotted] (right) -- (fright)node[pos=0, below]{$\xi_0$};
	\node[draw=none, inner sep=0pt, outer sep=0pt](aleft) at ($(left)+(.01,0)$){};
	\draw[draw=none, name path=line aleft] ($(-1,-1)!(aleft)!(7,-1)$) -- ($(-1,7)!(aleft)!(7,7)$);
	\node[draw=none, inner sep=1pt, outer sep=0pt, name intersections={of=curve and line aleft}](afleft) at (intersection-1){};
	\draw[thick, shorten >= -5.5cm, shorten <= -2.5cm] (fleft) -- (afleft);
	\node[draw=none, inner sep=0pt, outer sep=0pt](aright) at ($(right)+(.01,0)$){};
	\draw[draw=none, name path=line aright] ($(-1,-1)!(aright)!(7,-1)$) -- ($(-1,7)!(aright)!(7,7)$);
	\node[draw=none, inner sep=1pt, outer sep=0pt, name intersections={of=curve and line aright}](afright) at (intersection-1){};
	\draw[thick, shorten >= -3.5cm, shorten <= -2cm] (fright) -- (afright);
\end{tikzpicture}