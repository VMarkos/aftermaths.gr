\begin{tikzpicture}
	\draw[thick,->,name path=x axis] (-1,0) -- (7,0)node[pos=1,below]{$x$};
	\draw[thick,->,name path=y axis] (0,-1) -- (0,7)node[pos=1,left]{$y$};
	\node[left,yshift=-8pt] at (0,0){$O$};
	\draw[thick, name path=curve] (1,1) .. controls (3,6) and (5,-1) .. (6.5, 6.5)node[right]{$f$};
	\foreach \i in {1.05,1.35,...,6.5}{
		\pgfmathtruncatemacro{\coord}{10*\i}
		\pgfmathsetmacro{\next}{\i+0.5}
		\pgfmathsetmacro{\j}{\i+0.01}
		\draw[draw=none, name path=line \coord] (\i,-1) -- (\i,7);
		\node[draw=none, inner sep=0pt, outer sep=0pt, name intersections={of=curve and line \coord}](X\coord) at (intersection-1){};
		\draw[draw=none, name path=aline \coord] (\j,-1) -- (\j,7);
		\begin{pgfonlayer}{bg}
			\draw[thick, color=gray, shorten >=-1.2cm, shorten <=-1.2cm, name path=tangent \coord, name intersections={of=curve and aline \coord}] (X\coord) -- (intersection-1);
		\end{pgfonlayer}
	}
\end{tikzpicture}