\begin{tikzpicture}
	\draw[thick,->,name path=x axis] (-1,0) -- (3,0)node[pos=1,below]{$x$};
	\draw[thick,->,name path=y axis] (0,-1) -- (0,4)node[pos=1,left]{$y$};
