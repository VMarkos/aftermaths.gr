	\draw[thick, domain={-.9}:{(3.6)^(1/3)}] plot (\x,{\x*\x*\x})node[left]{$y=x^3$};
	\node[circle, inner sep=1pt, fill=black, label={right,yshift=-8pt,xshift=-2pt}:{$P(1,1)$}](P) at (1,1){};
	\draw[thick, domain={.4}:{5.6/3}] plot (\x,{3*\x-2})node[right]{$y=3x-1$};
