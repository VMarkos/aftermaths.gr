\begin{tikzpicture}
	\draw[thick,->,name path=x axis] (-1,0) -- (7,0)node[pos=1,below]{$x$};
	\draw[thick,->,name path=y axis] (0,-1) -- (0,7)node[pos=1,left]{$y$};
	\node[left,yshift=-8pt] at (0,0){$O$};
	\draw[thick, domain={1}:{6.5}, samples=200, name path=curve] plot (\x,{-.3*(\x-0)*(\x-10)-1.4})node[right]{$f$};
	\node[circle, inner sep=1pt, fill=black, label={above, xshift=-5pt}:{$A$}](a) at (1,1.3){};
	\node[circle, inner sep=1pt, fill=black, label={above}:{$B$}](b) at (6.5,5.425){};
	\node[circle, inner sep=1pt, fill=black, label={right}:{$B'$}](bp) at (6.5,1.3){};
	\draw[dashed] (0,0) rectangle (a);
	\draw[dashed] (0,0) rectangle (b);
	\draw[dashed] (0,0) rectangle (bp);
	\node[below] at ($(-1,0)!(a)!(7,0)$){$a$};
	\node[below] at ($(-1,0)!(b)!(7,0)$){$b$};
	\node[left] at ($(0,-1)!(a)!(0,7)$){$f(a)$};
	\node[left] at ($(0,-1)!(b)!(0,7)$){$f(b)$};
	\draw[thin, name path=line ab] (a) -- (b);
	\draw[dashed, name path=line x] (3,-1) -- (3,7)node[pos=.125,right,yshift=-4pt]{$x$};
	\node[circle, inner sep=1pt, fill=black, label={left,yshift=8pt}:{$P$}, name intersections={of=curve and line x}](p) at (intersection-1){};
	\node[circle, inner sep=1pt, fill=black, label={left,yshift=8pt}:{$Q$}, name intersections={of=line x and line ab}](q) at (intersection-1){};
	\node[circle, inner sep=1pt, fill=black, label={left,yshift=-8pt}:{$Q'$}](qp) at (3,1.3){};
	\node[left] at ($(0,-1)!(p)!(0,7)$){$f(x)$};
	\draw[dashed] (p) -- ($(0,-1)!(p)!(0,7)$);
	\draw[dashed] (q) -- ($(0,-1)!(q)!(0,7)$)node[pos=1,left]{$\dfrac{f(b)-f(a)}{b-a}(x-a)+f(a)$};
\end{tikzpicture}