\documentclass{beamer}
\usepackage[english,greek]{babel}
\usepackage[iso-8859-7]{inputenc}
\usepackage{amsthm,amsmath,amssymb,graphicx,bbm,extarrows,float,tikz,changepage,subcaption,ifthen,chngcntr,soul,setspace,parskip,cancel}
\usepackage{hyperref}
\usetikzlibrary{decorations.pathreplacing}
\usetikzlibrary{decorations.pathmorphing}
\usetikzlibrary{arrows.meta}
\usetikzlibrary{arrows}
\usetikzlibrary{positioning,matrix,scopes,fit,svg.path}
\usetikzlibrary{patterns}
\usetikzlibrary{intersections}
\usetikzlibrary{calc}
%\usetheme{CambridgeUS}
%\usecolortheme{orchid}

\beamertemplatenavigationsymbolsempty

\uselanguage{greek}

\setbeamertemplate{itemize items}[default]
  
\newcommand{\R}{\mathbb{R}}

\pgfdeclarelayer{bg}
\pgfsetlayers{bg,main}

\let\sin\relax
\DeclareMathOperator{\sin}{\text{ημ}}

\let\cos\relax
\DeclareMathOperator{\cos}{\text{συν}}

\let\tan\relax
\DeclareMathOperator{\tan}{\text{εφ}}

\begin{document}
\foreach \n in {1,...,20}{
    \begin{frame}[plain]
    \frametitle{\n\textsuperscript{η} Προσέγγιση}
    \begin{figure}[!htb]
    \centering
    \begin{tikzpicture}
    \draw[thick,->,name path=x axis] (-1,0) -- (7,0)node[pos=1,below]{$x$};
    \draw[thick,->,name path=y axis] (0,-1) -- (0,5)node[pos=1,left]{$y$};
    \node[left,yshift=-8pt](O) at (0,0){$O$};
    \pgfmathsetmacro{\greenRec}{5/3+(5.5-5/3)/\n}
    \pgfmathsetmacro{\newn}{\n-1}
    \draw[thick, blue!50!black, domain={1/4.5}:{6.5}, samples=200, name path=curve] plot(\x,{1/\x})node[right,yshift=4pt]{$f$};
    \draw[red] (1/3,0) -- (1/3,3)node[pos=0,below]{$a$};
    \draw[red] (1.1,0) -- (1.1,1/1.1)node[pos=0,below]{$b$};
    \node[red] at (4.3/6,-.7){$E_{\n}(a,b)$};
    \node[green!40!black] at (21.5/6,-.7){$E_{\n}(ta,tb)$};
    \draw[green!40!black] (5/3,0) -- (5/3,3/5)node[pos=0,below]{$ta$};
    \draw[green!40!black] (5.5,0) -- (5.5,1/5.5)node[pos=0,below]{$tb$};
    \foreach \i in {0,...,\newn}{
        \pgfmathtruncatemacro{\cp}{5*\i}
        \pgfmathsetmacro{\redRec}{(1.1-1/3)/\n}
        \pgfmathsetmacro{\thisRed}{1/3+\i*\redRec}
        \pgfmathsetmacro{\nextRed}{\thisRed+\redRec}
        \pgfmathsetmacro{\invRed}{1/\thisRed}
        \fill[red!\cp !blue, thick, fill opacity=.1, draw=red!\cp !blue] (\thisRed,0) rectangle (\nextRed,\invRed);
        \pgfmathsetmacro{\greenRec}{(5.5-5/3)/\n}
        \pgfmathsetmacro{\thisGreen}{5/3+\i*\greenRec}
        \pgfmathsetmacro{\nextGreen}{\thisGreen+\greenRec}
        \pgfmathsetmacro{\invGreen}{1/\thisGreen}
        \fill[[red!\cp !blue, thick, fill opacity=.1, draw=red!\cp !blue] (\thisGreen,0) rectangle (\nextGreen,\invGreen);
    }
    \end{tikzpicture}
    \end{figure}
    \end{frame}
}
\end{document}