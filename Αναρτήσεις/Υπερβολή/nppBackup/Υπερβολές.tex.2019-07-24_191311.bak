\beamertemplatenavigationsymbolsempty

\uselanguage{greek}

\setbeamertemplate{itemize items}[default]
  
\newcommand{\R}{\mathbb{R}}

\pgfdeclarelayer{bg}
\pgfsetlayers{bg,main}

\let\sin\relax
\DeclareMathOperator{\sin}{\text{зм}}

\let\cos\relax
\DeclareMathOperator{\cos}{\text{ухн}}

\let\tan\relax
\DeclareMathOperator{\tan}{\text{ец}}

\begin{document}
\foreach \n in {0.7,0.8,...,5.5}{
    \begin{frame}[plain]
    \begin{figure}[!htb]
    \centering
    \begin{tikzpicture}
    \pgfmathsetmacro{\i}{\n/3}
    \pgfmathsetmacro{\j}{\n*1.1}
    \pgfmathsetmacro{\k}{3/\n}
    \draw[thick,->,name path=x axis] (-1,0) -- (7,0)node[pos=1,below]{$x$};
    \draw[thick,->,name path=y axis] (0,-1) -- (0,5)node[pos=1,left]{$y$};
    \node[left,yshift=-8pt](O) at (0,0){$O$};
    \draw[thick, blue!50!black, domain={1/4.5}:{6.5}, samples=200, name path=curve] plot(\x,{1/\x})node[right,yshift=4pt]{$f$};
    \draw[red, opacity=.6] (1/3,0) -- (1/3,3)node[pos=0,below]{$a$};
    \draw[red, opacity=.6] (1.1,0) -- (1.1,3)node[pos=0,below]{$b$};
    \fill[red, thick, fill opacity=.1, draw=red, draw opacity=.6] (1/3,0) rectangle (1.1,3);
    \draw[green!40!black] (\i,0) -- (\i,\k)node[pos=0,below]{$ta$};
    \draw[green!40!black] (\j,0) -- (\j,\k)node[pos=0,below]{$tb$};
    \fill[green!40!black, thick, fill opacity=.1, draw=green!40!black] (\i,0) rectangle (\j,\k);
    \end{tikzpicture}
    \end{figure}
    \end{frame}
}
\end{document}