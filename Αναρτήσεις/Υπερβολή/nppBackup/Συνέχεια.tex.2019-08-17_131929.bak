\begin{document}
\foreach \n in {1,...,20}{
    \begin{frame}[plain]
    \frametitle{\n\textsuperscript{η} Προσέγγιση}
    \begin{figure}[!htb]
    \centering
    \begin{tikzpicture}
    \draw[thick,->,name path=x axis] (-1,0) -- (7,0)node[pos=1,below]{$x$};
    \draw[thick,->,name path=y axis] (0,-1) -- (0,5)node[pos=1,left]{$y$};
    \node[left,yshift=-8pt](O) at (0,0){$O$};
    \pgfmathsetmacro{\greenRec}{5/3+(5.5-5/3)/\n}
    \pgfmathsetmacro{\newn}{\n-1}
    \draw[thick, blue!50!black, domain={1/4.5}:{6.5}, samples=200, name path=curve] plot(\x,{1/\x})node[right,yshift=4pt]{$f$};
    \draw[]
    \end{tikzpicture}
    \end{figure}
    \end{frame}
}
\end{document}