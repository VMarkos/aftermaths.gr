\begin{document}
\begin{frame}
\frametitle{Μια ευθεία}
\begin{figure}
\centering
\begin{tikzpicture}
\draw[thick,->] (-1,0) -- (6,0)node[pos=1,below]{$x$};
\draw[thick,->] (0,-1) -- (0,6)node[pos=1,left]{$y$};
\node[circle, inner sep=1.5pt, fill=black, draw=black, label={left,yshift=-10pt}:{$O$}](o) at (0,0){};
\foreach \i in {1,...,5}{
    \ifthenelse{\i=0}{}{
        \draw (\i,-.1) -- (\i,.1)node[pos=0,below]{$\i$};
        \draw (-.1,\i) -- (.1,\i)node[pos=0,left]{$\i$};
    }
}
\node[circle, inner sep=1.5pt, fill=red, draw=red, label={above}:{$K$}](k) at (2,3){};
\node[circle, inner sep=1.5pt, fill=green!40!black, draw=green!40!black, label={right}:{$M$}](m) at (3,{3+sqrt(5)}){};
\begin{pgfonlayer}{bg}
\draw[thin,orange,domain={-1}:{6}] plot (\x,{\x/3+5/3});
\draw[dashed] (k) circle (2cm);
\end{pgfonlayer}
\end{tikzpicture}
\end{figure}
\end{frame}
