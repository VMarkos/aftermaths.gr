\begin{tikzpicture}
\draw[thick,->] (-4,0) -- (4,0)node[pos=1,below]{$x$};
\draw[thick,->] (0,-4) -- (0,4)node[pos=1,left]{$y$};
\node[circle, inner sep=1.5pt, fill=black, draw=black, label={left,yshift=-10pt}:{$O$}](o) at (0,0){};
\foreach \i in {-3,...,3}{
    \ifthenelse{\i=0}{}{
        \draw (\i,-.1) -- (\i,.1)node[pos=0,below]{$\i$};
        \draw (-.1,\i) -- (.1,\i)node[pos=0,left]{$\i$};
    }
}
\node[circle, inner sep=1.5pt, fill=red, draw=red, label={above}:{$A$}](a) at (2.4,1.7){};
\draw[dashed] (o) rectangle (a);
\end{tikzpicture}
