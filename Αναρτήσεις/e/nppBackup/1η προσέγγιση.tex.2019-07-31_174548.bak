\ExplSyntaxOn
\cs_set_eq:NN \fpeval \fp_eval:n
\ExplSyntaxOff

\begin{document}
\foreach \n in {1,...,100}{
    \begin{frame}[plain]
    \frametitle{\n\textsuperscript{η} Προσφορά}
    \begin{figure}[!htb]
    \centering
    \begin{tikzpicture}
    \pgfmathtruncatemacro{\i}{\n^(2.15)}
    %\def\i{(1+1/\n)^\n}
    \node[red!75!black] at (0,0){$\left(1+\dfrac{1}{\i}\right)^{\i}=\fpeval{(1+1/(\i))^(\i)}$};
    \end{tikzpicture}
    \end{figure}
    \end{frame}
}
\end{document}