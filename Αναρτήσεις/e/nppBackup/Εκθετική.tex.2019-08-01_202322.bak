\beamertemplatenavigationsymbolsempty

\uselanguage{greek}

\setbeamertemplate{itemize items}[default]
  
\newcommand{\R}{\mathbb{R}}

\pgfdeclarelayer{bg}
\pgfsetlayers{bg,main}

\let\sin\relax
\DeclareMathOperator{\sin}{\text{зм}}

\let\cos\relax
\DeclareMathOperator{\cos}{\text{ухн}}

\let\tan\relax
\DeclareMathOperator{\tan}{\text{ец}}

\ExplSyntaxOn
\cs_set_eq:NN \fpeval \fp_eval:n
\ExplSyntaxOff

\begin{document}
\foreach \n in {1,...,20}{
    \begin{frame}[plain]
    \begin{figure}[!htb]
    \centering
    \begin{tikzpicture}
    \draw[thick,->,name path=x axis] (-4,0) -- (5,0)node[pos=1,below]{$x$};
    \draw[thick,->,name path=y axis] (0,-1) -- (0,6)node[pos=1,left]{$y$};
    \node[left,yshift=-8pt](O) at (0,0){$O$};
    \draw[thick, blue!50!black, domain={-4}:{ln(6)}, samples=200, name path=curve] plot(\x,{exp(\x)})node[right,yshift=4pt]{$e^x$};
    \draw[thick, red!75!black, domain={-4}:{ln(6)}, samples=200] plot(\x,{\fpeval{((1+1/\n)^\n)}^(\x)})node[pos=.9,right,yshift=4pt]{$g_{\n}$};
    \end{tikzpicture}
    \end{figure}
    \end{frame}
}
\end{document}