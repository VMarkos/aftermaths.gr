\draw[thick,->,name path=x axis] (-4,0) -- (4,0)node[pos=1,below]{$x$};
\draw[thick,->,name path=y axis] (0,-2.5) -- (0,4)node[pos=1,left]{$y$};
\node[left,yshift=-8pt](O) at (0,0){$O$};
\draw[dashed] (0,0) circle (2cm);
\draw[very thick, blue!75!black, ->] (0,0) -- (40:2)node[pos=1,right]{$\vec{v}$};
\draw[very thick, red!75!black, ->] (0,0) -- (105:2)node[pos=1,above]{$\vec{u}$};
\draw[very thick, green!40!black, ->] (0,0) -- (30:2)node[pos=1,right]{$\vec{w}$};
\begin{pgfonlayer}{bg}
\filldraw[fill=blue!75!black, draw=blue!75!black, fill opacity=.1] (0,0) -- (.8,0) arc (0:40:.8) -- cycle node[pos=0,right,yshift=-8pt,xshift=2pt,opacity=1,blue!75!black]{$\phi$};
\filldraw[fill=red!75!black, draw=red!75!black, fill opacity=.1] (0,0) -- (.6,0) arc (0:105:.6) -- cycle node[pos=0,right,yshift=6pt,xshift=4pt,opacity=1,red!75!black]{$\theta$};
\filldraw[fill=green!40!black, draw=green!40!black, fill opacity=.1] (0,0) -- (1.2,0) arc (0:30:1.2) -- cycle node[pos=0,right,yshift=-8pt,xshift=4pt,opacity=1,green!40!black]{$\omega$};
\end{pgfonlayer}
