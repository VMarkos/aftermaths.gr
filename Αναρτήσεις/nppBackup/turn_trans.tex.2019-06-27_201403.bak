\begin{document}
\begin{frame}
\frametitle{Η στροφή και η αντιμεταθετική ιδιότητα}
\begin{figure}
\centering
\begin{tikzpicture}
\draw[thick,->,name path=x axis] (-4,0) -- (4,0)node[pos=1,below]{$x$};
\draw[thick,->,name path=y axis] (0,-2.5) -- (0,4)node[pos=1,left]{$y$};
\node[left,yshift=-8pt](O) at (0,0){$O$};
\draw[dashed] (0,0) circle (2cm);
\draw[very thick, blue!75!black, ->] (0,0) -- (30:2)node[pos=1,right]{$\vec{v}$};
\draw[very thick, red!75!black, ->] (0,0) -- (75:2)node[pos=1,above]{$\vec{u}$};
\begin{pgfonlayer}{bg}
\filldraw[fill=blue!75!black, draw=blue!75!black, fill opacity=.1] (0,0) -- (.8,0) arc (0:30:.8) -- cycle node[pos=0,right,yshift=-4pt,opacity=1,blue!75!black]{$\phi$};
\filldraw[fill=red!75!black, draw=red!75!black, fill opacity=.1] (0,0) -- (.6,0) arc (0:75:.6) -- cycle node[pos=0,right,xshift=4pt,opacity=1,red!75!black]{$\theta$};
\end{pgfonlayer}
\end{tikzpicture}
\end{figure}
\end{frame}

\begin{frame}
\frametitle{Στρίβοντας το $\vec{v}$ κατά $\vec{u}$ ($\vec{v}\odot\vec{u}$)}
\begin{figure}
\centering
\begin{tikzpicture}
\draw[thick,->,name path=x axis] (-4,0) -- (4,0)node[pos=1,below]{$x$};
\draw[thick,->,name path=y axis] (0,-2.5) -- (0,4)node[pos=1,left]{$y$};
\node[left,yshift=-8pt](O) at (0,0){$O$};
\draw[dashed] (0,0) circle (2cm);
\begin{scope}[opacity=.3]
\draw[very thick, blue!75!black, ->] (0,0) -- (30:2)node[pos=1,right]{$\vec{v}$};
\draw[very thick, red!75!black, ->] (0,0) -- (75:2)node[pos=1,above]{$\vec{u}$};
\begin{pgfonlayer}{bg}
\begin{scope}[opacity=.3]
\filldraw[fill=blue!75!black, draw=blue!75!black,opactiy=.3] (0,0) -- (.8,0) arc (0:30:.8) -- cycle node[pos=0,right,yshift=-4pt,blue!75!black]{$\phi$};
\filldraw[fill=red!75!black, draw=red!75!black,opacity=.3] (0,0) -- (.6,0) arc (0:75:.6) -- cycle node[pos=0,right,xshift=4pt,red!75!black]{$\theta$};
\end{scope}
\end{pgfonlayer}
\end{scope}
\end{tikzpicture}
\end{figure}
\end{frame}
